; Chrono Chess MVP - Godot 4.7.2
; The rule engine is intentionally kept free of scene dependencies.

config_version=5

[application]

config/name="Chrono Chess MVP"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/app/Main.tscn"

[autoload]

GameSession="*res://scripts/autoload/GameSession.gd"
SaveService="*res://scripts/persistence/SaveService.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
